"""400 MiB loopback reference-protocol test: disconnect, resume, lost final ACK.
This exercises the protocol design and disk persistence model, not the native Win32 EXE.
"""
import os, socket, struct, tempfile, threading, zlib
from pathlib import Path

CHUNK = 1 << 20
TOTAL_BLOCKS = 400
SIZE = CHUNK * TOTAL_BLOCKS
MAGIC = b"ROSHDF08"
USER = "tester".encode("utf-16le").ljust(128, b"\0")
DEVICE = "ROSHD-TEST-PC".encode("utf-16le").ljust(128, b"\0")
NAME = "resume-400MiB.bin".encode("utf-16le")
WRITE_TIME = struct.pack("<II", 123456, 789)
HEADER = MAGIC + USER + DEVICE + struct.pack("<I", len(NAME)) + struct.pack("<Q", SIZE) + WRITE_TIME + NAME


def exact(sock, n):
    out = bytearray()
    while len(out) < n:
        part = sock.recv(n - len(out))
        if not part:
            if not out:
                return None
            raise AssertionError(f"truncated stream: wanted {n}, got {len(out)}")
        out.extend(part)
    return bytes(out)


def receive_block(sock, out):
    header = exact(sock, 9)
    if header is None:
        return False
    raw_size, enc_size, mode = struct.unpack("<IIB", header)
    assert mode == 0 and raw_size == enc_size and 0 < raw_size <= CHUNK
    payload = exact(sock, enc_size)
    assert payload is not None and len(payload) == raw_size
    out.write(payload)
    out.flush()
    return True


def send_block(sock, source, offset, length):
    source.seek(offset)
    data = source.read(length)
    assert len(data) == length
    sock.sendall(struct.pack("<IIB", length, length, 0) + data)
    return data


def main():
    errors = []
    with tempfile.TemporaryDirectory(prefix="roshd_resume_400m_") as td:
        root = Path(td)
        src = root / "source.bin"
        part = root / "receive.part"
        final = root / "received.bin"
        done = root / "received.done"
        pattern = os.urandom(CHUNK)
        crc = 0
        with src.open("wb") as f:
            for _ in range(TOTAL_BLOCKS):
                f.write(pattern)
                crc = zlib.crc32(pattern, crc)

        listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        listener.bind(("127.0.0.1", 0))
        listener.listen(4)
        host, port = listener.getsockname()

        def server():
            try:
                for attempt in range(3):
                    conn, _ = listener.accept()
                    with conn:
                        assert exact(conn, len(HEADER)) == HEADER
                        if final.exists() and done.exists():
                            conn.sendall(b"D")
                            continue
                        offset = part.stat().st_size if part.exists() else 0
                        prefix_crc = 0
                        if part.exists():
                            with part.open("rb") as pf:
                                while True:
                                    block = pf.read(CHUNK)
                                    if not block:
                                        break
                                    prefix_crc = zlib.crc32(block, prefix_crc)
                        # C implementation exchanges the unfinalized CRC32 state with the offset.
                        conn.sendall(b"Y" + struct.pack("<Q", offset) + struct.pack("<I", prefix_crc ^ 0xFFFFFFFF))
                        if attempt == 0:
                            with part.open("ab") as out:
                                for _ in range(3):
                                    assert receive_block(conn, out)
                                # A real link failure closes the stream here. The partial file stays.
                                assert exact(conn, 9) is None
                        elif attempt == 1:
                            with part.open("ab") as out:
                                while offset < SIZE:
                                    assert receive_block(conn, out)
                                    offset = out.tell()
                            expected = exact(conn, 4)
                            assert expected is not None
                            expected_crc = struct.unpack("<I", expected)[0]
                            actual_crc = 0
                            with part.open("rb") as f:
                                while True:
                                    block = f.read(CHUNK)
                                    if not block:
                                        break
                                    actual_crc = zlib.crc32(block, actual_crc)
                            assert expected_crc == actual_crc == crc
                            os.replace(part, final)
                            done.write_bytes(b"committed")
                            # Simulate the receiver committing the file but its final ACK being lost.
                            # The sender must reconnect and receive D rather than re-send the file.
                        else:
                            raise AssertionError("unexpected attempt order")
            except Exception as exc:
                errors.append(repr(exc))
            finally:
                listener.close()

        th = threading.Thread(target=server, daemon=True)
        th.start()

        # Attempt 1: send only 3 MiB and deliberately disconnect.
        with src.open("rb") as f, socket.create_connection((host, port), timeout=30) as sock:
            sock.sendall(HEADER)
            status = exact(sock, 1)
            assert status == b"Y"
            offset = struct.unpack("<Q", exact(sock, 8))[0]
            crc_state = struct.unpack("<I", exact(sock, 4))[0]
            assert offset == 0 and crc_state == 0xFFFFFFFF
            for i in range(3):
                send_block(sock, f, i * CHUNK, CHUNK)
        # Attempt 2: resume from the persisted offset and complete; ACK is intentionally lost.
        with src.open("rb") as f, socket.create_connection((host, port), timeout=60) as sock:
            sock.sendall(HEADER)
            assert exact(sock, 1) == b"Y"
            offset = struct.unpack("<Q", exact(sock, 8))[0]
            crc_state = struct.unpack("<I", exact(sock, 4))[0]
            assert offset == 3 * CHUNK, offset
            assert crc_state == (zlib.crc32(pattern * 3) ^ 0xFFFFFFFF)
            running_state = crc_state
            while offset < SIZE:
                length = min(CHUNK, SIZE - offset)
                block = send_block(sock, f, offset, length)
                running_state = zlib.crc32(block, running_state ^ 0xFFFFFFFF) ^ 0xFFFFFFFF
                offset += length
            sock.sendall(struct.pack("<I", running_state ^ 0xFFFFFFFF))
            assert exact(sock, 1) is None  # receiver committed, ACK dropped
        # Attempt 3: idempotent completion response, no duplicate data transfer.
        with socket.create_connection((host, port), timeout=30) as sock:
            sock.sendall(HEADER)
            assert exact(sock, 1) == b"D"

        th.join(timeout=30)
        assert not th.is_alive(), "server thread did not finish"
        assert not errors, errors
        assert final.exists() and final.stat().st_size == SIZE
        assert not part.exists() and done.exists()
        print("PASS: 400 MiB transfer resumed after 3 MiB interruption; final ACK loss recovered idempotently")


if __name__ == "__main__":
    main()
